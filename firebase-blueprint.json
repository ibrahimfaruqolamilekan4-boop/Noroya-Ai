{
  "entities": {
    "Trade": {
      "title": "Trade",
      "description": "A user-owned trade journal entry recording Scalp or Normal trade setups and settled outcomes",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "The Firebase Authentication UID of the trade owner"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the trade was recorded"
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Trading ticker symbol (e.g. XAUUSD, V75, BTCUSDT.P)"
        },
        "timeframe": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "description": "Chart timeframe (M1, M5, M15, H1, H4, D1)"
        },
        "trading_style": {
          "type": "string",
          "enum": ["SCALP", "NORMAL"],
          "description": "Selected trade setup style (SCALP or NORMAL)"
        },
        "bias": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Trade direction bias (BULLISH, BEARISH, NEUTRAL)"
        },
        "entry_price": {
          "type": "number",
          "description": "Planned or executed entry price"
        },
        "stop_loss": {
          "type": "number",
          "description": "Stop loss price level"
        },
        "take_profit": {
          "type": "number",
          "description": "Primary take profit price level"
        },
        "risk_reward": {
          "type": "string",
          "maxLength": 32,
          "description": "Formatted risk-to-reward ratio (e.g. 1:2.5)"
        },
        "image_url": {
          "type": "string",
          "maxLength": 350000,
          "description": "Compressed chart snapshot data URI or external URL (capped safely under Firestore 1MB doc limit)"
        },
        "notes": {
          "type": "string",
          "maxLength": 20000,
          "description": "Trader execution notes and post-trade review"
        },
        "status": {
          "type": "string",
          "enum": ["PENDING", "WON", "LOST", "BREAKEAVEN"],
          "description": "Current settlement status of the trade"
        },
        "analysis_info": {
          "type": "object",
          "description": "Structured AI analysis summary attached to the trade"
        },
        "exit_price": {
          "type": "number",
          "description": "Actual closing execution price"
        },
        "pnl": {
          "type": "number",
          "description": "Realized profit or loss amount in USD"
        }
      },
      "required": [
        "userId",
        "created_at",
        "symbol",
        "timeframe",
        "bias",
        "entry_price",
        "stop_loss",
        "take_profit",
        "status"
      ]
    },
    "ChatHistory": {
      "title": "ChatHistory",
      "description": "Stored conversation messages between the trader and the AI Trading Coach",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "The Firebase Authentication UID of the message owner"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "description": "The message text content"
        },
        "sender": {
          "type": "string",
          "enum": ["user", "bot"],
          "description": "Sender role identifier"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the message"
        }
      },
      "required": ["userId", "message", "sender", "created_at"]
    },
    "UserLearning": {
      "title": "UserLearning",
      "description": "Personal trading rules, lessons, and observations stored by the user to personalize AI setups",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "The Firebase Authentication UID of the rule owner"
        },
        "learnings": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000,
          "description": "The user's custom trading rule or market observation"
        },
        "symbol": {
          "type": "string",
          "maxLength": 64,
          "description": "Optional related ticker symbol (e.g. XAUUSD, V75, General)"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Category label (e.g. Scalp Rules, Stop Loss, Psychology, Spikes)"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when learning was saved"
        }
      },
      "required": ["userId", "learnings", "category", "created_at"]
    },
    "AnalysisReport": {
      "title": "AnalysisReport",
      "description": "Cloud-saved Scalp or Normal Trade AI chart analysis snapshot for quick history recall",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "The Firebase Authentication UID of the report owner"
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Analyzed market symbol"
        },
        "timeframe": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "description": "Chart timeframe analyzed"
        },
        "tradingStyle": {
          "type": "string",
          "enum": ["SCALP", "NORMAL"],
          "description": "Setup style requested during scan"
        },
        "bias": {
          "type": "string",
          "maxLength": 32,
          "description": "Detected trade bias (BULLISH, BEARISH, NEUTRAL)"
        },
        "confluenceScorePct": {
          "type": "number",
          "description": "0-100 setup quality score"
        },
        "summary": {
          "type": "string",
          "maxLength": 2000,
          "description": "Short plain-English trade summary"
        },
        "entry": {
          "type": "number",
          "description": "Recommended entry level"
        },
        "stopLoss": {
          "type": "number",
          "description": "Recommended stop loss level"
        },
        "tp1": {
          "type": "number",
          "description": "First take profit target"
        },
        "riskReward": {
          "type": "string",
          "maxLength": 32,
          "description": "Risk-to-reward string"
        },
        "reportData": {
          "type": "object",
          "description": "Full structured AI report payload (without oversized raw images)"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when analysis was completed"
        }
      },
      "required": [
        "userId",
        "symbol",
        "timeframe",
        "tradingStyle",
        "bias",
        "confluenceScorePct",
        "entry",
        "stopLoss",
        "tp1",
        "created_at"
      ]
    },
    "UserPreferences": {
      "title": "UserPreferences",
      "description": "Cross-device workstation preferences synced per user in Firestore",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "The Firebase Authentication UID matching the document ID"
        },
        "tradingStyle": {
          "type": "string",
          "enum": ["SCALP", "NORMAL"],
          "description": "Preferred default trade setup style"
        },
        "defaultSymbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Last selected ticker symbol"
        },
        "defaultTimeframe": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "description": "Last selected chart timeframe"
        },
        "accountBalance": {
          "type": "number",
          "description": "Preferred account balance for risk calculator"
        },
        "riskPercent": {
          "type": "number",
          "description": "Preferred risk percentage per trade (0.1 - 25)"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last preference sync"
        }
      },
      "required": ["userId", "tradingStyle", "defaultSymbol", "defaultTimeframe", "updated_at"]
    }
  },
  "firestore": {
    "/trades/{tradeId}": {
      "schema": "Trade",
      "description": "User-owned Scalp & Normal trade journal ledger"
    },
    "/chat_history/{chatId}": {
      "schema": "ChatHistory",
      "description": "AI Trading Coach conversation history per user"
    },
    "/user_learnings/{learningId}": {
      "schema": "UserLearning",
      "description": "Personal trader rules and observations fed into the AI analyzer"
    },
    "/analysis_reports/{reportId}": {
      "schema": "AnalysisReport",
      "description": "History of completed AI Scalp & Normal chart analysis reports per user"
    },
    "/user_preferences/{userId}": {
      "schema": "UserPreferences",
      "description": "Per-user workstation preferences (setup style, default market, timeframe, risk sizing)"
    }
  }
}
