{
  "entities": {
    "Trade": {
      "title": "Trade",
      "description": "A trading log document representing synthetic indices SMC setups",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The Firebase Authentication UID of the owner"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when the trade was recorded"
        },
        "symbol": {
          "type": "string",
          "description": "Trading ticker indicator name (e.g. V75)"
        },
        "timeframe": {
          "type": "string",
          "description": "Trading analysis chart timeframe"
        },
        "bias": {
          "type": "string",
          "description": "SMC market bias (BULLISH, BEARISH, NEUTRAL)"
        },
        "entry_price": {
          "type": "number",
          "description": "Trade entry level price pointer"
        },
        "stop_loss": {
          "type": "number",
          "description": "Trade invalidation stop loss level"
        },
        "take_profit": {
          "type": "number",
          "description": "Trade take profit target level"
        },
        "risk_reward": {
          "type": "string",
          "description": "Formatted risk-to-reward ratio (e.g. 1:3)"
        },
        "image_url": {
          "type": "string",
          "description": "Base64 encoded chart snapshot or external image reference"
        },
        "notes": {
          "type": "string",
          "description": "User notes or logs about trade execution"
        },
        "status": {
          "type": "string",
          "enum": ["PENDING", "WON", "LOST", "BREAKEAVEN"],
          "description": "Settled trade state status"
        },
        "analysis_info": {
          "type": "object",
          "description": "Embedded JSON representation of Gemini SMC details"
        },
        "exit_price": {
          "type": "number",
          "description": "Trade exit/close execution price"
        },
        "pnl": {
          "type": "number",
          "description": "Calculated profit and loss amount generated by this trade"
        }
      },
      "required": ["userId", "created_at", "symbol", "timeframe", "bias", "entry_price", "stop_loss", "take_profit", "status"]
    },
    "ChatHistory": {
      "title": "ChatHistory",
      "description": "Stored chat session logs between user and Gemini AI bot",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user participating in the chat"
        },
        "message": {
          "type": "string",
          "description": "The raw message text content"
        },
        "sender": {
          "type": "string",
          "enum": ["user", "bot"],
          "description": "Message sender identification"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of the message"
        }
      },
      "required": ["userId", "message", "sender", "created_at"]
    },
    "UserLearning": {
      "title": "UserLearning",
      "description": "Stored observations, rules, and learnings the AI bot relies on for custom recommendations",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The UID of the user owner"
        },
        "learnings": {
          "type": "string",
          "description": "The observation or lesson (e.g., 'Vol75 tends to sweep H4 order block before reversal')"
        },
        "symbol": {
          "type": "string",
          "description": "Related index ticker context"
        },
        "category": {
          "type": "string",
          "description": "Categorized learnings group (e.g., Spikes, Psychology, Structure)"
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when learning was stored"
        }
      },
      "required": ["userId", "learnings", "category", "created_at"]
    }
  },
  "firestore": {
    "/trades/{tradeId}": {
      "schema": "Trade",
      "description": "Global user-specific trade logs collection"
    },
    "/chat_history/{chatId}": {
      "schema": "ChatHistory",
      "description": "Bot conversation logs collection"
    },
    "/user_learnings/{learningId}": {
      "schema": "UserLearning",
      "description": "Custom user notes, observations, and psychology learnings"
    }
  }
}
